---
import { socialLinks } from '../data/social';
---

<footer class="border-t border-gray-200 dark:border-gray-700 py-8 mt-12">
  <div class="max-w-6xl mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-4">
    <p class="text-sm text-gray-500">
      © {new Date().getFullYear()} 我的个人网站. All rights reserved.
      <br class="md:hidden" />
      <span class="md:ml-4">
        <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer"
           class="hover:text-blue-600 dark:hover:text-blue-400 transition">
          粤ICP备2026097535号
        </a>
      </span>
    </p>
    <div class="flex items-center gap-4">
      {socialLinks.map(link => (
        <a href={link.url} target="_blank" rel="noopener noreferrer"
           class="text-gray-500 hover:text-blue-600 dark:hover:text-blue-400 transition text-lg"
           title={link.name}>
          {link.icon}
        </a>
      ))}
    </div>
  </div>
</footer>
