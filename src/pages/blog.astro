---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="博客" description="文章列表">
  <div class="max-w-4xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold mb-4">📝 博客</h1>
    <p class="text-gray-600 dark:text-gray-400 mb-12">分享技术与思考</p>

    {posts.length > 0 ? (
      <div class="space-y-10">
        {posts.map(post => (
          <article class="border-b border-gray-200 dark:border-gray-700 pb-8 last:border-0">
            <a href={`/blog/${post.slug}`} class="group">
              <h2 class="text-2xl font-semibold group-hover:text-blue-600 dark:group-hover:text-blue-400 transition">
                {post.data.title}
              </h2>
            </a>
            <div class="flex items-center gap-4 mt-2 text-sm text-gray-500 dark:text-gray-400">
              <time>{post.data.pubDate.toLocaleDateString('zh-CN', {year:'numeric',month:'long',day:'numeric'})}</time>
              {post.data.tags.length > 0 && (
                <div class="flex gap-2">
                  {post.data.tags.map(tag => (
                    <span class="bg-gray-100 dark:bg-slate-800 px-2 py-0.5 rounded text-xs">#{tag}</span>
                  ))}
                </div>
              )}
            </div>
            <p class="mt-3 text-gray-600 dark:text-gray-400 leading-relaxed">{post.data.description}</p>
            <a href={`/blog/${post.slug}`} class="inline-block mt-3 text-sm text-blue-600 hover:underline">
              阅读全文 →
            </a>
          </article>
        ))}
      </div>
    ) : (
      <div class="text-center py-20">
        <p class="text-4xl mb-4">📝</p>
        <p class="text-gray-400">还没有文章，敬请期待 🚧</p>
      </div>
    )}
  </div>
</BaseLayout>
